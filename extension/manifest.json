{
  "manifest_version": 3,
  "name": "Specter AI Chat Tracker",
  "version": "1.0",
  "description": "Extracts text from AI chats (ChatGPT, Claude, Gemini) and sends it to Specter locally.",
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1:5000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}
